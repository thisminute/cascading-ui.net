// Global layout and typography

.page {
    font-family: "system-ui, -apple-system, sans-serif";
    line-height: "1.7";
}

.content {
    max-width: "720px";
    margin: "0 auto";
    padding: "0 24px 80px";
}

.toggle {
    position: "fixed";
    top: "20px";
    right: "20px";
    z-index: "100";
}

.section {
    margin-bottom: "56px";
}

.section_title {
    font-size: "1.35rem";
    font-weight: "700";
    margin-bottom: "20px";
    letter-spacing: "-0.01em";
}

.description {
    margin-bottom: "16px";
}

.code_block {
    font-family: "ui-monospace, SFMono-Regular, Menlo, monospace";
    font-size: "0.85rem";
    background: $code;
    color: "#e2e8f0";
    padding: "20px 24px";
    border-radius: "10px";
    margin: "20px 0";
    white-space: "pre";
    overflow-x: "auto";
    line-height: "1.6";
}

.footer {
    margin-top: "80px";
    padding-top: "24px";
    border-top: "1px solid #e8e8e8";
    font-size: "0.85rem";
    text-align: "center";
    opacity: "0.5";
}
