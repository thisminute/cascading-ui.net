// Selling point items

.point {
    margin-bottom: "20px";
    padding: "20px 24px";
    background: "#f7f8fa";
    border-radius: "8px";

    .point_title {
        font-weight: "700";
        font-size: "1rem";
        margin-bottom: "4px";
        color: "#0f0f23";
    }

    .point_body {
        color: "#555";
        font-size: "0.95rem";
    }
}
