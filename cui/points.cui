// Selling point items

.point {
    margin-bottom: "20px";
    padding: "20px 24px";
    background: $tile;
    border-radius: "8px";

    .point_title {
        font-weight: "700";
        font-size: "1rem";
        margin-bottom: "4px";
    }

    .point_body {
        font-size: "0.95rem";
        opacity: "0.7";
    }
}
