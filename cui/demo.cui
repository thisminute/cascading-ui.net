// Live demo component

.demo_area {
    padding: "32px 24px";
    background: "#f7f8fa";
    border-radius: "10px";
    margin: "20px 0";
    text-align: "center";

    .demo_label {
        font-size: "0.9rem";
        color: "#888";
        margin-bottom: "12px";
    }

    .demo_button {
        padding: "10px 20px";
        background: "#0f0f23";
        color: "white";
        border: "none";
        border-radius: "6px";
        font-size: "0.95rem";
        cursor: "pointer";
        font-weight: "500";
    }
}
