// Live demo component

.demo_area {
    padding: "32px 24px";
    background: $tile;
    border-radius: "10px";
    margin: "20px 0";
    text-align: "center";

    .demo_label {
        font-size: "0.9rem";
        margin-bottom: "12px";
        opacity: "0.6";
    }

    .demo_button {
        padding: "10px 20px";
        background: $code;
        color: "#e2e8f0";
        border: "none";
        border-radius: "6px";
        font-size: "0.95rem";
        cursor: "pointer";
        font-weight: "500";
    }
}
